# Backend Environment Variables
# Copy this file to .env and update with your values

# =============================================================================
# DATABASE (Required for production)
# =============================================================================
# Local development (Docker Compose)
DATABASE_URL=postgresql+asyncpg://odte_user:your_secure_password_here@localhost:5432/odte_gex

# Local development fallback (project-owned Postgres, when Docker isn't available)
# DATABASE_URL=postgresql+asyncpg://odte_user:odte_password@127.0.0.1:55432/odte_gex

# Railway production format (use this when deploying to Railway):
# DATABASE_URL=postgresql+asyncpg://${{ PGUSER }}:${{ PGPASSWORD }}@${{ PGHOST }}:${{ PGPORT }}/${{ PGDATABASE }}

# =============================================================================
# DATA PROVIDERS (Required)
# =============================================================================
DATA_PROVIDER=yfinance

# Tradier example:
# TRADIER_API_KEY=your_tradier_api_key_here
# TRADIER_BASE_URL=https://api.tradier.com/v1

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000

# Environment: development | staging | production
ENVIRONMENT=development

# Enable debug mode (false in production)
DEBUG=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Development
CORS_ORIGINS=["http://localhost:3000"]

# Production example (update with your actual domains):
# CORS_ORIGINS=["https://your-app.vercel.app", "https://your-custom-domain.com"]

# =============================================================================
# OPTIONAL: API Rate Limiting
# =============================================================================
# Maximum requests per minute per IP (default: 100)
# API_RATE_LIMIT=100

# =============================================================================
# OPTIONAL: WebSocket Authentication
# =============================================================================
# Enable WebSocket authentication (default: false)
# WS_AUTH_ENABLED=false
# WS_AUTH_SECRET=your_jwt_secret_here
